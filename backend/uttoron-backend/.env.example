DATABASE_URL=postgresql://user:password@host:5432/postgres
PORT=3000
PIN_SALT_ROUNDS=10

# Supabase Storage — service_role key only, never expose to the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Multi-tenancy (docs/MULTI_TENANCY.md)
# DATABASE_URL above is the OWNER role (bypasses row level security): used only for login/register/auth lookups.
# DATABASE_URL_APP is the restricted `uttoron_app` role the route handlers use; row level security applies to it.
# Leave it unset and the API runs as before with isolation NOT enforced (a warning is logged).
DATABASE_URL_APP=
# Organization new passports join when the sign-up request doesn't name one.
DEFAULT_ORG_SLUG=aim-initiative
